{
  "name": "taskmaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "build:local": "npm run typecheck && vite build --mode local-preview --outDir dist-local",
    "preview:local": "vite preview --host 127.0.0.1 --outDir dist-local",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start",
    "db:test:supabase": "supabase test db",
    "test:db:native": "TASKMASTER_NATIVE_SUPABASE=1 vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "otpauth": "9.5.2",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
